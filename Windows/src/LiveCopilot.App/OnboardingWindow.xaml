<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LiveCopilot.App.OnboardingWindow" x:Name="OnboardingRoot" Style="{StaticResource {x:Type Window}}" Icon="Resources/AppIcon.png" Title="LiveCopilot — 欢迎" Width="980" Height="680" MinWidth="860" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{StaticResource OnboardingSurface}" AutomationProperties.AutomationId="OnboardingWindow" AutomationProperties.ItemStatus="{Binding Step}">
  <Window.Resources>
    <Style x:Key="SetupCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="SetupHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
      <Setter Property="Margin" Value="0,4,0,6"/>
    </Style>
    <Style x:Key="SetupSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
      <Setter Property="Margin" Value="0,2,0,6"/>
    </Style>
    <Style x:Key="CompactChoiceCard" TargetType="ListBoxItem" BasedOn="{StaticResource ChoiceCard}">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <!-- Budget for YaHei UI at 1.4 x font size; keep language choices unchanged. -->
    <Style x:Key="ScenarioChoiceCard" TargetType="ListBoxItem" BasedOn="{StaticResource ChoiceCard}">
      <Setter Property="Padding" Value="10,2"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <DataTemplate x:Key="ModelCardTemplate">
      <Border Style="{StaticResource SetupCard}" Padding="10,6" Margin="0,0,0,6">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Margin="12,0,0,0" Foreground="{StaticResource SecondaryInk}"/>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.ItemStatus="{Binding Status}"/>
          </DockPanel>
          <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsVerifying}" Minimum="0" Maximum="100" Height="5" Margin="0,4,0,0"/>
          <DockPanel Margin="0,4,0,0">
            <WrapPanel DockPanel.Dock="Right">
              <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Padding" Value="9,2"/>
                  <Setter Property="Margin" Value="4,0,0,0"/>
                </Style>
              </WrapPanel.Resources>
              <Button Content="{Binding DownloadLabel}" IsEnabled="{Binding CanDownload}" Click="DownloadModel" AutomationProperties.AutomationId="{Binding DownloadId}"/>
              <Button Content="取消" IsEnabled="{Binding CanCancel}" Click="CancelModel"/>
              <Button Content="校验" IsEnabled="{Binding CanVerify}" Click="VerifyModel"/>
              <Button Content="删除" IsEnabled="{Binding CanDelete}" Click="DeleteModel"/>
            </WrapPanel>
            <TextBlock Text="{Binding Transfer}" VerticalAlignment="Center" Foreground="{StaticResource SecondaryInk}"/>
          </DockPanel>
          <TextBlock Text="{Binding Hint}" Foreground="{StaticResource SecondaryInk}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}Hint}"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="CredentialTemplate">
      <StackPanel Margin="0,6,0,4" IsEnabled="{Binding CanEdit}">
        <DockPanel Margin="0,0,0,4">
          <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Margin="12,0,0,0"/>
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
        </DockPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="清除密钥" Command="{Binding ClearCommand}"/>
          <PasswordBox Loaded="CredentialLoaded" PasswordChanged="CredentialChanged" Padding="7" Margin="0,0,10,0" ToolTip="输入新密钥；点击“继续”后生效。不会回填已存密钥。"/>
        </DockPanel>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="28,20,28,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Image Source="Resources/AppIcon.png" Width="28" Height="28" Margin="0,0,8,0"/>
      <TextBlock Style="{StaticResource Brand}"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="4,14,4,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="24"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ScrollViewer x:Name="IntroScroll" AutomationProperties.AutomationId="OnboardingIntroScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Center" Margin="0,4,6,4">
          <TextBlock Text="{Binding Title}" AutomationProperties.AutomationId="OnboardingTitle">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource OnboardingTitle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsScenario}" Value="True">
                    <Setter Property="FontSize" Value="28"/>
                    <Setter Property="LineHeight" Value="40"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Subtitle}" FontSize="14">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                <Setter Property="Margin" Value="0,12,0,12"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsScenario}" Value="True"><Setter Property="Margin" Value="0,6,0,8"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <StackPanel Visibility="{Binding IsLanguage, Converter={StaticResource Visible}}">
            <ListBox ItemsSource="{Binding Settings.Languages}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Settings.Language, Mode=TwoWay}" ItemContainerStyle="{StaticResource CompactChoiceCard}" BorderThickness="0" Background="Transparent" AutomationProperties.AutomationId="OnboardingLanguage"/>
            <TextBlock Text="偏好将保存；Windows 界面为简体中文。" Style="{StaticResource Hint}" AutomationProperties.AutomationId="OnboardingLanguageHint"/>
          </StackPanel>
          <StackPanel Visibility="{Binding IsScenario, Converter={StaticResource Visible}}">
            <ListBox ItemsSource="{Binding UsageChoices}" SelectedValuePath="Value" SelectedValue="{Binding Usage, Mode=TwoWay}" ItemContainerStyle="{StaticResource ScenarioChoiceCard}" BorderThickness="0" Background="Transparent" AutomationProperties.AutomationId="OnboardingUsage">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel><TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource SecondaryInk}"/></StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Margin="0,4,0,0">
              <TextBlock Text="使用场景" Margin="0,0,12,0" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding Settings.Scenarios}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Scenario, Mode=TwoWay}" Margin="0" AutomationProperties.AutomationId="OnboardingScenario"/>
            </DockPanel>
            <TextBlock Text="仅保存偏好，点击悬浮窗播放才监听。" Style="{StaticResource Hint}" Margin="0,6,0,0" AutomationProperties.AutomationId="OnboardingScenarioHint"/>
          </StackPanel>
          <StackPanel Visibility="{Binding IsReady, Converter={StaticResource Visible}}">
            <TextBlock Text="随时唤出助手" FontWeight="SemiBold"/>
            <TextBlock x:Name="ShortcutHint" Style="{StaticResource Hint}"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="DetailScroll" AutomationProperties.AutomationId="OnboardingDetailScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,4,12,12">
          <StackPanel Visibility="{Binding IsLanguage, Converter={StaticResource Visible}}">
            <TextBlock Text="你好" FontSize="72" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,135,0,10"/>
            <TextBlock Text="欢迎使用 LiveCopilot" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryInk}"/>
          </StackPanel>
          <StackPanel Visibility="{Binding IsScenario, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource SetupCard}" Background="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="对话示例" Style="{StaticResource SetupSectionTitle}"/>
                <TextBlock Text="以下内容仅为演示，不会采集音频或调用服务。" Style="{StaticResource SetupHint}"/>
                <Separator/>
                <TextBlock Text="对方 · 你在这个项目中具体负责什么？"/>
                <Separator/>
                <TextBlock Text="我 · 我主要负责产品的设计与实现。"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SetupCard}" Background="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="回答建议" Style="{StaticResource SetupSectionTitle}"/>
                <TextBlock Text="我会先说明目标，再介绍具体的方法，最后用结果说明我的贡献。"/>
                <TextBlock Text="输入问题 → 生成回答 → 按需总结或追问" Style="{StaticResource SetupHint}"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Visibility="{Binding IsModels, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource SetupCard}" Background="{StaticResource Surface}" Padding="10,8" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                <TextBlock Text="语音识别"/>
                <ComboBox ItemsSource="{Binding Settings.ListeningServices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.ListeningService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0">
                  <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                      <Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
                    </Style>
                  </ComboBox.ItemContainerStyle>
                </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="资料检索"/><ComboBox ItemsSource="{Binding Settings.EmbeddingServices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.EmbeddingService, Mode=TwoWay}" Margin="0,4,0,0"/></StackPanel>
              </Grid>
            </Border>
            <ContentControl Content="{Binding ZipformerModel, ElementName=OnboardingRoot}" ContentTemplate="{StaticResource ModelCardTemplate}"/>
            <ContentControl Content="{Binding ParaformerModel, ElementName=OnboardingRoot}" ContentTemplate="{StaticResource ModelCardTemplate}"/>
            <ContentControl Content="{Binding EmbeddingModelCard, ElementName=OnboardingRoot}" ContentTemplate="{StaticResource ModelCardTemplate}"/>
            <TextBlock Text="本地模型使用 CPU，无需 GPU 运行库。Jev / Laya 即将推出，也可先用文字提问。" Style="{StaticResource SetupHint}"/>
          </StackPanel>
          <StackPanel Visibility="{Binding IsAnalysis, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource SetupCard}" Background="{StaticResource Surface}">
              <StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <TextBlock Text="回答服务" Width="86" VerticalAlignment="Center"/>
                  <ComboBox ItemsSource="{Binding Settings.ReasoningServices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.ReasoningService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                </DockPanel>
                <StackPanel Visibility="{Binding Settings.IsCatalogService, Converter={StaticResource Visible}}">
                  <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="回答模型" Width="86" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Settings.Models}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Settings.AnalysisModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                  </DockPanel>
                </StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <TextBlock Text="推理强度" Width="86" VerticalAlignment="Center"/>
                  <ComboBox ItemsSource="{Binding Settings.ThinkingModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.AnalysisThinking, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                </DockPanel>
                <StackPanel Visibility="{Binding Settings.IsCompatible, Converter={StaticResource Visible}}">
                  <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="HTTPS 地址" Width="86" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Settings.CompatibleBaseURL, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Margin="0"/>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="接口路径" Width="86" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Settings.CompatiblePath, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Margin="0"/>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="模型名称" Width="86" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Settings.CompatibleModel, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Margin="0"/>
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SetupCard}" Background="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="密钥保存到 Windows 凭据管理器。继续会保存设置；不会自动发送请求。" Style="{StaticResource SetupHint}"/>
              </StackPanel>
            </Border>
            <ContentControl x:Name="SelectedCredential" ContentTemplate="{StaticResource CredentialTemplate}"/>
            <TextBlock Text="API 调用可能产生所选服务的用量费用。连接尚未测试。" Style="{StaticResource SetupHint}"/>
          </StackPanel>
          <StackPanel Visibility="{Binding IsPermissions, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource SetupCard}" Background="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="麦克风" Style="{StaticResource SetupSectionTitle}"/>
                <TextBlock Text="在 Windows 设置 → 隐私和安全性 → 麦克风中，开启“麦克风访问权限”和“允许桌面应用访问麦克风”。Windows 10 的入口位于“隐私”。" Style="{StaticResource SetupHint}"/>
                <Button Content="打开麦克风隐私设置" HorizontalAlignment="Left" Click="OpenMicrophonePrivacy" AutomationProperties.AutomationId="OpenMicrophonePrivacy"/>
                <TextBlock x:Name="PermissionMessage" Style="{StaticResource OptionalText}" Foreground="{StaticResource SecondaryInk}" FontSize="13" Margin="0,4,0,6"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SetupCard}" Background="{StaticResource Surface}">
              <StackPanel>
                <TextBlock Text="系统音频" Style="{StaticResource SetupSectionTitle}"/>
                <TextBlock Text="通过 Windows WASAPI 回环采集当前输出设备的声音。无需 macOS 屏幕录制权限；请确认会议声音从预期的扬声器或耳机输出。" Style="{StaticResource SetupHint}"/>
              </StackPanel>
            </Border>
            <TextBlock Text="当前未验证音频权限。引导不会启动录音；首次点击悬浮窗的开始按钮后检查设备是否可用。" Style="{StaticResource SetupHint}"/>
          </StackPanel>
          <StackPanel Visibility="{Binding IsReady, Converter={StaticResource Visible}}">
            <TextBlock Text="准备情况" Style="{StaticResource SetupSectionTitle}"/>
            <Border Style="{StaticResource SetupCard}" Background="{StaticResource Surface}">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="语音转写" Width="86" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ReadySpeech"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="回答服务" Width="86" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ReadyAnalysis"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="资料检索" Width="86" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ReadyEmbedding"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock Text="音频权限" Width="86" FontWeight="SemiBold"/>
                  <TextBlock Text="尚未验证 · 开始监听后检查麦克风与系统音频。"/>
                </DockPanel>
                <DockPanel>
                  <TextBlock Text="Jev Mode" Width="86" FontWeight="SemiBold" AutomationProperties.AutomationId="ReadyJev"/>
                  <TextBlock Text="即将推出" Foreground="{StaticResource SecondaryInk}"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="点击“进入 LiveCopilot”后可直接输入问题。开始监听需另行点击悬浮窗顶部的播放按钮。" Style="{StaticResource SetupHint}"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="2">
      <TextBlock Text="{Binding Error}" Style="{StaticResource OptionalText}" Foreground="{StaticResource ErrorInk}"/>
      <TextBlock Text="{Binding Settings.ValidationSummary}" Style="{StaticResource OptionalText}" Foreground="{StaticResource ErrorInk}"/>
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Content="返回" Command="{Binding BackCommand}" AutomationProperties.AutomationId="OnboardingBack" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Left">
          <ItemsControl ItemsSource="{Binding Segments}" Width="200" AutomationProperties.AutomationId="OnboardingProgress">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Height="5" CornerRadius="3" Margin="0,0,5,0">
                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource Stroke}"/>
                  <Style.Triggers><DataTrigger Binding="{Binding Reached}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Opacity" Value="0.45"/></DataTrigger>
                    <DataTrigger Binding="{Binding Current}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers>
                </Style></Border.Style>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding StepLabel}" FontSize="12" Foreground="{StaticResource SecondaryInk}" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="稍后设置" Command="{Binding SkipCommand}" AutomationProperties.AutomationId="OnboardingSkip" Background="Transparent"/>
          <Button Content="{Binding NextLabel}" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="OnboardingNext"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
