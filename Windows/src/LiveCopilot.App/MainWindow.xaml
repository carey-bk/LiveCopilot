<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LiveCopilot.App.MainWindow" Style="{StaticResource {x:Type Window}}" Icon="Resources/AppIcon.png" Title="LiveCopilot" FontSize="13" Width="480" Height="470" MinWidth="460" MinHeight="400" MaxWidth="700" MaxHeight="1000" WindowStyle="None" ResizeMode="CanResizeWithGrip" Topmost="True" ShowActivated="False" WindowStartupLocation="CenterScreen" Background="{StaticResource OverlaySurface}" AutomationProperties.AutomationId="MainWindow">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="16" GlassFrameThickness="0"/>
  </WindowChrome.WindowChrome>
  <Border x:Name="OverlayBorder" Background="{StaticResource OverlaySurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="16" Padding="14">
    <Grid x:Name="OverlayLayout">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="56"/>
      </Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="DragHeader" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image Source="Resources/AppIcon.png" Width="22" Height="22" Margin="0,0,8,0"/>
          <TextBlock Style="{StaticResource OverlayBrand}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="StartButton" Content="&#xE768;" Style="{StaticResource IconButton}" Foreground="{StaticResource Success}" ToolTip="开始监听" AutomationProperties.Name="开始监听" AutomationProperties.AutomationId="StartListening" Click="StartListening" IsEnabled="False"/>
          <Button x:Name="StopButton" Content="&#xE71A;" Style="{StaticResource IconButton}" ToolTip="停止监听与回答" AutomationProperties.Name="停止监听与回答" Click="StopListening" IsEnabled="False"/>
          <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Command="{Binding ResetSessionCommand}" ToolTip="停止并保存当前会话，清空转写与回答" AutomationProperties.Name="重置会话" AutomationProperties.AutomationId="ResetSession"/>
          <Button Content="{Binding MicrophoneGlyph}" Style="{StaticResource IconButton}" Command="{Binding ToggleMicrophoneCommand}" ToolTip="{Binding MicrophoneHint}" AutomationProperties.Name="{Binding MicrophoneHint}" AutomationProperties.AutomationId="ToggleMicrophone"/>
          <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource IconButton}" ToolTip="设置" AutomationProperties.Name="设置" AutomationProperties.AutomationId="OpenSettings" Click="OpenSettings" IsEnabled="False"/>
          <Button x:Name="PinButton" Content="&#xE718;" Style="{StaticResource IconButton}" ToolTip="切换置顶" AutomationProperties.Name="切换置顶" Click="TogglePin"/>
          <Button Content="&#xE921;" Style="{StaticResource IconButton}" ToolTip="隐藏到系统托盘" AutomationProperties.Name="隐藏到系统托盘" AutomationProperties.AutomationId="HideOverlay" Click="HideOverlay"/>
          <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" ToolTip="退出 LiveCopilot" AutomationProperties.Name="退出 LiveCopilot" AutomationProperties.AutomationId="ExitApplication" Click="ExitApplication"/>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1">
        <TextBlock x:Name="StateText" Text="就绪，可以输入问题或开始监听" Foreground="{StaticResource SecondaryInk}" FontSize="12"/>
        <TextBlock x:Name="HostErrorText" Style="{StaticResource OptionalText}" Foreground="{StaticResource ErrorInk}" FontSize="12"/>
        <TextBlock Text="{Binding MicrophoneChangeNotice}" Style="{StaticResource OptionalText}" Foreground="{StaticResource SecondaryInk}" FontSize="12"/>
        <TextBlock Text="{Binding SessionActionError}" Style="{StaticResource OptionalText}" Foreground="{StaticResource ErrorInk}" FontSize="12"/>
        <TextBlock x:Name="ErrorText" Style="{StaticResource OptionalText}" Foreground="{StaticResource ErrorInk}" FontSize="12"/>
      </StackPanel>
      <GroupBox x:Name="OperationGuide" Grid.Row="2" Background="{StaticResource Selection}" Padding="12" Margin="0,10,0,0"
              Visibility="{Binding Guide.IsVisible, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="OperationGuide" AutomationProperties.ItemStatus="{Binding Guide.Step}">
        <GroupBox.Template><ControlTemplate TargetType="GroupBox"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10"><ContentPresenter/></Border></ControlTemplate></GroupBox.Template>
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="跳过提示" Command="{Binding Guide.SkipCommand}" Background="Transparent" Padding="4,0" FontSize="12" AutomationProperties.AutomationId="OperationGuideSkip"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Guide.StepLabel}" Margin="8,0" Foreground="{StaticResource SecondaryInk}"/>
            <TextBlock Text="{Binding Guide.Title}" FontWeight="SemiBold" FontSize="14"/>
          </DockPanel>
          <TextBlock Text="{Binding Guide.Description}" Margin="0,8,0,10" Foreground="{StaticResource SecondaryInk}" FontSize="12"/>
          <TextBlock Text="{Binding Guide.Error}" Style="{StaticResource OptionalText}" Foreground="{StaticResource ErrorInk}"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{Binding Guide.NextLabel}" Command="{Binding Guide.NextCommand}" Padding="12,4" AutomationProperties.AutomationId="OperationGuideNext"/>
            <Button Content="打开设置" Click="OpenSettings" Background="Transparent" Padding="0,4" HorizontalAlignment="Left" AutomationProperties.AutomationId="OperationGuideSettings"/>
          </DockPanel>
        </StackPanel>
      </GroupBox>
      <StackPanel Grid.Row="3" Margin="0,10,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="翻译 · 即将推出" Foreground="{StaticResource SecondaryInk}" FontSize="11" VerticalAlignment="Center"/>
          <Button x:Name="CollapseButton" Click="CollapseTranscript" HorizontalAlignment="Left" Background="Transparent" Foreground="{StaticResource SecondaryInk}" Padding="0,2" AutomationProperties.Name="折叠转写" AutomationProperties.AutomationId="CollapseTranscript"><StackPanel Orientation="Horizontal"><TextBlock x:Name="CollapseGlyph" Text="&#xE70E;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="CollapseLabel" Text="折叠转写"/></StackPanel></Button>
        </DockPanel>
        <ScrollViewer x:Name="TranscriptScroll" AutomationProperties.AutomationId="TranscriptScroll" Height="90" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock x:Name="TranscriptPlaceholder" Text="开启监听后，对话会显示在这里。" Foreground="{StaticResource SecondaryInk}"/>
            <StackPanel x:Name="TranscriptLines"/>
            <TextBlock x:Name="PartialThem" Foreground="{StaticResource SecondaryInk}"/>
            <TextBlock x:Name="PartialYou" Foreground="{StaticResource SecondaryInk}"/>
          </StackPanel>
        </ScrollViewer>
        <CheckBox Content="跟随最新转写" IsChecked="{Binding FollowTranscript}" HorizontalAlignment="Right" FontSize="12" AutomationProperties.AutomationId="FollowTranscript"/>
        <Separator/>
      </StackPanel>
      <Grid Grid.Row="4" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="106"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ReplyButton" Click="RequestReply" Padding="8,4" AutomationProperties.Name="生成回答" AutomationProperties.AutomationId="RequestReply"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="生成回答"/></StackPanel></Button>
          <Button x:Name="RecapButton" Click="RequestRecap" Padding="8,4" AutomationProperties.Name="总结" AutomationProperties.AutomationId="RequestRecap"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A4;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="总结"/></StackPanel></Button>
          <Button x:Name="FollowUpButton" Click="RequestFollowUp" Padding="8,4" AutomationProperties.Name="追问" AutomationProperties.AutomationId="RequestFollowUp"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE897;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="追问"/></StackPanel></Button>
        </StackPanel>
        <ComboBox Grid.Column="1" Margin="0" ItemsSource="{Binding AnswerLanguages}" SelectedValuePath="Value" SelectedValue="{Binding AnswerLanguage, Mode=TwoWay}" AutomationProperties.Name="回答语言" AutomationProperties.AutomationId="AnswerLanguageMenu">
          <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Label}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
      <StackPanel Grid.Row="5">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="提问" Command="{Binding AskCommand}" IsDefault="True" Margin="6,0,0,0" AutomationProperties.AutomationId="AskQuestion"/>
          <TextBox MinHeight="30" VerticalContentAlignment="Center" x:Name="QuestionInput" Style="{StaticResource QuestionInputStyle}" Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" Margin="0" AutomationProperties.Name="输入问题，无需开启监听" AutomationProperties.AutomationId="ManualQuestion" ToolTip="输入问题，无需开启监听"/>
        </DockPanel>
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
          </Grid.ColumnDefinitions>
          <CheckBox Content="附带近期对话" HorizontalAlignment="Left" IsChecked="{Binding IncludeConversation}" FontSize="12" AutomationProperties.AutomationId="IncludeConversation"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding KnowledgeModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding KnowledgeMode, Mode=TwoWay}" Margin="0" AutomationProperties.Name="知识模式" AutomationProperties.AutomationId="KnowledgeModeMenu"/>
        </Grid>
        <DockPanel Margin="0,4,0,0">
          <TextBlock DockPanel.Dock="Right" x:Name="ShortcutText" Foreground="{StaticResource SecondaryInk}" FontSize="11"/>
          <TextBlock x:Name="ScenarioText" Text="面试" Foreground="{StaticResource SecondaryInk}" FontSize="12"/>
        </DockPanel>
        <Separator/>
      </StackPanel>
      <ScrollViewer Grid.Row="6" x:Name="AnswerScroll" AutomationProperties.AutomationId="AnswerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="AnswerPanel">
          <TextBlock x:Name="SuggestionText" Style="{StaticResource OptionalText}" Foreground="{StaticResource SecondaryInk}" FontSize="12"/>
          <TextBlock AutomationProperties.AutomationId="AnswerText" x:Name="AnswerText" Text="在上方输入问题，或开始监听以获取回答。" Foreground="{StaticResource SecondaryInk}"/>
          <TextBlock x:Name="SourcesText" Style="{StaticResource OptionalText}" Foreground="{StaticResource Accent}" FontSize="12"/>
          <TextBlock x:Name="WarningText" Style="{StaticResource OptionalText}" Foreground="{StaticResource ErrorInk}" FontSize="12"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
