<Window x:Class="LiveCopilot.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveCopilot — 设置" Width="940" Height="760" MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="SettingsWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="TextBox"><Setter Property="Padding" Value="7" /><Setter Property="Margin" Value="0,3,0,10" /></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="7" /><Setter Property="Margin" Value="0,3,0,10" /></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,0,10" /></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,7" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="DimGray" /><Setter Property="Margin" Value="0,3,0,12" /></Style>
        <DataTemplate x:Key="CredentialTemplate">
            <StackPanel Margin="0,12,0,4" IsEnabled="{Binding CanEdit}">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="清除密钥" Command="{Binding ClearCommand}" />
                    <PasswordBox Loaded="CredentialLoaded" PasswordChanged="CredentialChanged" Padding="7" Margin="0,0,10,0" ToolTip="输入新密钥；点击页面底部保存后生效。不会回填已存密钥。" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock Text="{Binding ValidationSummary}" Foreground="DarkRed" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Command="{Binding SaveCommand}" MinWidth="90" />
                <Button Content="取消" AutomationProperties.AutomationId="CancelSettings" Command="{Binding CancelCommand}" MinWidth="90" />
            </StackPanel>
        </StackPanel>
        <TabControl x:Name="Pages" TabStripPlacement="Left">
            <TabControl.Resources>
                <Style TargetType="TabItem"><Setter Property="Padding" Value="18,12" /><Setter Property="MinWidth" Value="110" /></Style>
            </TabControl.Resources>
            <TabItem Header="通用" AutomationProperties.AutomationId="GeneralPage"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,16" IsEnabled="{Binding CanEdit}">
                <TextBlock Text="通用" FontSize="24" Margin="0,0,0,18" />
                <TextBlock Text="界面语言" /><ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="本批 Windows 设置页使用中文文案；语言偏好会保存供支持本地化的界面使用。" Style="{StaticResource Hint}" />
                <TextBlock Text="回答语言" /><ComboBox ItemsSource="{Binding AnswerLanguages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AnswerLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="使用场景" /><ComboBox ItemsSource="{Binding Scenarios}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Scenario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="自动建议" IsChecked="{Binding AutomaticSuggestions}" />
                <TextBlock Text="连续提问策略" /><ComboBox ItemsSource="{Binding QuestionPolicies}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ContinuousQuestionPolicy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="当前 Windows 会话通过快捷键请求回答；自动建议与连续提问策略保存为偏好，自动触发流程尚未接入。" Style="{StaticResource Hint}" />
                <CheckBox Content="双语回答" IsChecked="{Binding BilingualAnswers}" />
                <TextBlock Text="附加回答指令（最多 4000 个 UTF-16 单元）" /><TextBox Text="{Binding AdditionalAnswerInstructions, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="浮窗转写字体大小（11–28）" /><TextBox Text="{Binding TranscriptFontSizeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"  />
                <TextBlock Text="浮窗回答字体大小（11–28）" /><TextBox Text="{Binding AnswerFontSizeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"  />
                <CheckBox Content="浮窗自动高度" IsChecked="{Binding OverlayAutoHeight}" />
                <CheckBox Content="共享屏幕时隐藏浮窗" IsChecked="{Binding ExcludeOverlayFromCapture}" />
                <TextBlock Text="共享隐藏由 Windows 捕获保护实现，实际效果取决于系统版本和共享软件。" Style="{StaticResource Hint}" />
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="服务" AutomationProperties.AutomationId="ServicesPage"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,16" IsEnabled="{Binding CanEdit}">
                <TextBlock Text="服务" FontSize="24" Margin="0,0,0,18" />
                <TextBlock Text="听写引擎" /><ComboBox ItemsSource="{Binding ListeningServices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ListeningService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding ListeningHint}" Style="{StaticResource Hint}" />
                <TextBlock Text="听写语言" /><ComboBox ItemsSource="{Binding SpeechLanguages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LiveSpeechLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="听写语言与回答语言独立保存。本地双语模型自动识别中英文，不按语言偏好强制过滤。" Style="{StaticResource Hint}" />
                <TextBlock Text="推理服务" /><ComboBox ItemsSource="{Binding ReasoningServices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ReasoningService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Visibility="{Binding IsCatalogService, Converter={StaticResource Visible}}">
                    <TextBlock Text="推理模型" /><ComboBox ItemsSource="{Binding Models}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding AnalysisModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock Text="推理强度" /><ComboBox ItemsSource="{Binding ThinkingModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AnalysisThinking, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Visibility="{Binding IsCompatible, Converter={StaticResource Visible}}">
                <TextBlock Text="兼容接口 BaseURL（必须为 HTTPS）" /><TextBox Text="{Binding CompatibleBaseURL, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"  />
                <TextBlock Text="兼容接口 Path" /><TextBox Text="{Binding CompatiblePath, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"  />
                <TextBlock Text="兼容接口 Model" /><TextBox Text="{Binding CompatibleModel, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"  />
                </StackPanel>
                <TextBlock Text="API 密钥" FontSize="20" Margin="0,16,0,6" />
                <TextBlock Text="密钥只存入 Windows 凭据管理器。输入框仅用于替换；保存或取消后清空。清除密钥同样在保存后生效。" Style="{StaticResource Hint}" />
                <ContentControl Content="{Binding OpenAICredential}" ContentTemplate="{StaticResource CredentialTemplate}" />
                <ContentControl Content="{Binding SeparateOpenAICredential}" ContentTemplate="{StaticResource CredentialTemplate}" />
                <ContentControl Content="{Binding DeepSeekCredential}" ContentTemplate="{StaticResource CredentialTemplate}" />
                <ContentControl Content="{Binding CompatibleCredential}" ContentTemplate="{StaticResource CredentialTemplate}" Visibility="{Binding IsCompatible, Converter={StaticResource Visible}}" />
                <ContentControl Content="{Binding PresetCredential}" ContentTemplate="{StaticResource CredentialTemplate}" Visibility="{Binding IsPreset, Converter={StaticResource Visible}}" />
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="知识库" x:Name="KnowledgePage" AutomationProperties.AutomationId="KnowledgePage"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,16" IsEnabled="{Binding CanEdit}">
                <TextBlock Text="知识库" FontSize="24" Margin="0,0,0,18" />
                <TextBlock Text="回答模式" /><ComboBox ItemsSource="{Binding KnowledgeModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding KnowledgeMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="嵌入服务" /><ComboBox ItemsSource="{Binding EmbeddingServices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EmbeddingService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="OpenAI 嵌入模型（本地使用固定 BGE-M3）" /><TextBox Text="{Binding EmbeddingModel, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"  />
                <TextBlock Text="检索数量（3–8）" /><TextBox Text="{Binding RetrievalCountText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"  />
                <TextBlock Text="{Binding SelectedEmbeddingIdentity}" Style="{StaticResource Hint}" />
                <TextBlock Text="{Binding EmbeddingHint}" Style="{StaticResource Hint}" />
                <TextBlock Text="{Binding KnowledgeRebuildHint}" Foreground="DarkOrange" TextWrapping="Wrap" />
                <TextBlock Text="先保存设置，再操作文档。导入、删除和重建会立即执行，不随取消设置撤销。" Style="{StaticResource Hint}" />
                <WrapPanel x:Name="KnowledgeActionsPanel" Margin="0,8">
                    <Button Content="导入文档" Click="ImportDocuments" />
                    <Button Content="重新索引" Click="ReindexDocument" />
                    <Button Content="删除" Click="DeleteDocument" />
                </WrapPanel>
                <ListView x:Name="DocumentsList" Height="180" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View><GridView>
                        <GridViewColumn Header="名称" Width="150" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="状态" Width="150" DisplayMemberBinding="{Binding StatusLabel}" />
                        <GridViewColumn Header="分块数" Width="65" DisplayMemberBinding="{Binding ChunkCount}" />
                        <GridViewColumn Header="嵌入模型" Width="230" DisplayMemberBinding="{Binding EmbeddingModel}" />
                    </GridView></ListView.View>
                </ListView>
                <ProgressBar x:Name="KnowledgeProgress" Minimum="0" Maximum="100" Height="6" Margin="0,8,0,0" />
                <TextBlock x:Name="KnowledgeMessageText" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="历史记录" AutomationProperties.AutomationId="HistoryPage"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,16" IsEnabled="{Binding CanEdit}">
                <TextBlock Text="历史记录" FontSize="24" Margin="0,0,0,18" />
                <TextBlock Text="{Binding HistoryNotice}" FontSize="18" />
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="快捷键" AutomationProperties.AutomationId="ShortcutsPage"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,16" IsEnabled="{Binding CanEdit}">
                <TextBlock Text="快捷键" FontSize="24" Margin="0,0,0,18" />
                <TextBlock Text="点击重新录制后按组合键；Esc 取消录制。录制期间暂停全局快捷键。Windows 保留组合与重复绑定会被拒绝。" Style="{StaticResource Hint}" />
                <ItemsControl ItemsSource="{Binding Shortcuts}"><ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <WrapPanel>
                            <TextBlock Text="{Binding Display}" Width="200" VerticalAlignment="Center" />
                            <Button Content="重新录制" Click="RecordShortcut" />
                            <Button Content="恢复默认" Command="{Binding ResetCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock x:Name="RecordingText" TextWrapping="Wrap" Margin="0,4,0,10" />
                <TextBlock Text="{Binding ShortcutError}" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,4,0,10" />
                <Button Content="全部恢复默认" Command="{Binding ResetShortcutsCommand}" HorizontalAlignment="Left" />
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="关于" AutomationProperties.AutomationId="AboutPage"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,16" IsEnabled="{Binding CanEdit}">
                <TextBlock Text="关于" FontSize="24" Margin="0,0,0,18" />
                <TextBlock Text="LiveCopilot Windows" FontSize="20" />
                <TextBlock Text="{Binding DisplayVersion, StringFormat=版本：{0}}" Margin="0,12" />
                <TextBlock Text="{Binding ProjectUrl}" TextWrapping="Wrap" Margin="0,8" />
                <Button Content="打开项目主页" Click="OpenProject" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding UnsignedNotice}" TextWrapping="Wrap" Margin="0,24,0,0" />
                <TextBlock Text="{Binding RuntimeNotice}" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                <CheckBox Content="允许检查应用更新（默认关闭）" IsChecked="{Binding CheckForUpdates}" />
                <TextBlock Text="{Binding UpdateNotice}" Style="{StaticResource Hint}" />
                <Button Content="检查更新" Click="CheckUpdates" HorizontalAlignment="Left" />
                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" />
            </StackPanel></ScrollViewer></TabItem>
        </TabControl>
    </DockPanel>
</Window>
